+    let exit_index = frames
+        .iter()
+        .position(|frame| frame["type"] == "run_exit")
+        .expect("run should emit exit");
+    assert!(
+        frames[exit_index + 1..]
+            .iter()
+            .all(|frame| frame["type"] != "run_input_waiting")
+    );
