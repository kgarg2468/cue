+        .expect("start request should write");
+    let mut reader = BufReader::new(stream);
+    let mut frames = vec![read_json_frame(&mut reader)];
+    assert_eq!(frames[0]["type"], "run_input_waiting");
+    assert_eq!(frames[0]["run_id"], "input-wait-pipe-run");
+    assert!(
