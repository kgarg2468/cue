+            .is_some_and(|quiet| quiet >= 300)
+    );
+
+    assert_eq!(
+        control_process(&backend.socket_path, "close_stdin", "input-wait-pipe-run")["status"],
+        "accepted"
+    );
+    frames.extend(
+        reader.lines().map(|line| {
+            serde_json::from_str(&line.expect("frame should read")).expect("frame JSON")
+        }),
+    );
